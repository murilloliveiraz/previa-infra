# =====================================================================
# PrevIA - Arquivo central de configuracao da infraestrutura
# Todos os scripts leem este arquivo. Altere aqui, nunca dentro dos scripts.
# =====================================================================

# ---------- Identidade do servidor ----------
PREVIA_HOSTNAME="previa-srv01"
PREVIA_DOMAIN="previa.local"
TIMEZONE="America/Sao_Paulo"

# ---------- Rede ----------
# NET_INTERFACE=auto detecta a interface da rota padrao.
NET_INTERFACE="auto"
# Deixe STATIC_IP vazio para manter DHCP (recomendado em Vagrant/VirtualBox NAT).
# Exemplo de IP fixo: STATIC_IP="192.168.56.10/24" e STATIC_GATEWAY="192.168.56.1"
STATIC_IP=""
STATIC_GATEWAY=""
DNS_SERVERS="1.1.1.1 8.8.8.8"
# Nomes internos que apontam para o proprio servidor
APP_HOSTNAMES="app.previa.local api.previa.local painel.previa.local"

# ---------- Aplicacao ----------
APP_NAME="previa"
APP_USER="previa"
APP_DIR="/opt/previa"
APP_PORT="8000"
APP_WORKERS="2"
APP_ENV="production"
APP_VERSION="1.0.0"
DATA_DIR="/var/lib/previa"
DB_PATH="/var/lib/previa/previa.db"
CONF_DIR="/etc/previa"

# ---------- Monitoramento ----------
# ATENCAO: o systemd (EnvironmentFile) NAO aceita comentario na mesma linha
# do valor. Mantenha os comentarios sempre em linhas separadas.
# Segundos entre coletas
MON_INTERVAL="15"
# % de uso que dispara ALERTA (>= 95% vira CRITICO)
CPU_LIMIT="80"
MEM_LIMIT="80"
DISK_LIMIT="85"
# Monitor reinicia app/nginx automaticamente se cairem
AUTO_HEAL="true"

# ---------- Logs ----------
LOG_DIR="/var/log/previa"
